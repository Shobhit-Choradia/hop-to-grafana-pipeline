        <type>String</type>
      </field>
    </fields>
    <scriptLanguage>python</scriptLanguage>
    <scripts>
      <script>
        <scriptBody># Use str() to handle the incoming field
val = str(raw_date).strip()

# Replace slashes with dashes and split
parts = val.replace('/', '-').split('-')

if len(parts) == 3:
    p0 = int(parts[0])
    p1 = int(parts[1])
    p2 = parts[2] # Year

    # Logic: if first part > 12, it's Day-Month-Year
    if p0 > 12:
        # Use .format() instead of f-strings
        Normalized_Date = "{}-{}-{}".format(p2, parts[1], parts[0])
    # Logic: if second part > 12, it's Month-Day-Year
    elif p1 > 12:
        Normalized_Date = "{}-{}-{}".format(p2, parts[0], parts[1])
    # Default fallback
    else:
        Normalized_Date = "{}-{}-{}".format(p2, parts[0], parts[1])
else:
    Normalized_Date = None</scriptBody>
        <scriptName>script1</scriptName>
        <scriptType>0</scriptType>
      </script>
    </scripts>
